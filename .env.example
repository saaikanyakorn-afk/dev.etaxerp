# ===== REQUIRED =====
# Database connection string (PostgreSQL) - Primary database (USA/Replit)
DATABASE_URL=postgresql://username:password@localhost:5432/etax_center

# ===== STAGE 2: LOCAL DEVELOPMENT =====
# Test database (Thailand/deep-main) - Used by the Developer Menu for local testing
# DATABASE_URL_TEST=postgresql://etaxusr:nJKsyhE4583Hz@deep-main.hopto.org:5432/etax_center_test

# ===== OPTIONAL (features will be limited without these) =====
# LINE Messaging API (for LINE tracking notifications)
LINE_CHANNEL_ACCESS_TOKEN=

# Resend Email Service (for sending emails)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# OpenAI API Key (for AI features: slip verification, demand forecasting)
OPENAI_API_KEY=

# ===== SERVER =====
# Server port (default: 5000)
PORT=5000
